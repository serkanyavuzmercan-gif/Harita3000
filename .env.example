DATABASE_URL=sqlite+aiosqlite:///./harita3000.db
# PostgreSQL + PostGIS: postgresql+asyncpg://harita:harita@localhost:5432/harita3000
JWT_SECRET=dev-only-harita3000-change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# false: giriş ekranı yok, program açılınca yönetici olarak çalışır (tek kullanıcılı yerel kullanım).
# true: kullanıcı adı ve parola ister, roller (lojistik, pazarlamacı, sürücü) devreye girer.
AUTH_REQUIRED=false

# auto: anahtar varsa Google, yoksa OpenStreetMap | osm: her zaman OpenStreetMap | google
MAP_PROVIDER=auto
GOOGLE_MAPS_API_KEY=

# OpenStreetMap tarafı. Yoğun kullanımda kendi sunucunuzu veya ücretli bir sağlayıcıyı yazın.
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=Harita3000/1.0 (saha-operasyon)

# Denizli
MAP_CENTER_LAT=37.7765
MAP_CENTER_LNG=29.0864
MAP_ZOOM=10
DEPOT_LAT=37.8000
DEPOT_LNG=29.0500
DEPOT_LABEL=Denizli Merkez Depo

# Firma sekmesinde varsayılan depo seçilince rota başlangıcı oradan alınır; DEPOT_* yalnızca yedek değerdir.

UPLOAD_DIR=uploads
REPORT_DIR=reports
CORS_ORIGINS=*
TIMEZONE=Europe/Istanbul

# Filo takip entegrasyonları
# Arvento/Mobiliz kimlik bilgileri bu anahtarla şifrelenir. Üretimde uzun ve rastgele bir değer verin;
# değiştirirseniz kayıtlı entegrasyonların kimlik bilgilerini yeniden girmeniz gerekir.
INTEGRATION_SECRET=dev-only-harita3000-integration-secret
# Birden fazla sunucu süreci çalıştırıyorsanız yalnızca birinde true bırakın.
TELEMATICS_POLLER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
# Tarayıcının araç konumlarını yenileme aralığı (saniye)
VEHICLE_REFRESH_SECONDS=60
POSITION_RETENTION_DAYS=180
# Gün sonu raporlarının otomatik arşive yazılma saati (yerel saat)
DAILY_REPORT_HOUR=23
DAILY_REPORT_MINUTE=30
